# Copy to .env and fill in. Never commit real values.

# SQLite for local development. For production use PostgreSQL, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/seo_os"  (see docs/DEPLOYMENT.md)
DATABASE_URL="file:./dev.db"

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used to encrypt integration credentials at rest. Changing it makes stored credentials unreadable.
ENCRYPTION_KEY=""

# Public base URL of the app (used in share links and OAuth redirects).
APP_URL="http://localhost:3000"

# Optional: free Google Gemini key (https://aistudio.google.com) for AI-written audit summaries.
# Without it the audit uses its rule-based summary and marks the AI stage as skipped.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-flash-latest"   (default; follows Google's current Flash model)
# GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"   (used automatically when the main model is overloaded; set "" to disable)

# Recommended: free PageSpeed Insights API key (Google Cloud Console → APIs & Services → enable
# "PageSpeed Insights API" → Credentials → Create API key). Without it Google's shared keyless
# quota is often exhausted and tests fail with "quota reached".
PAGESPEED_API_KEY=""

# Optional: Gmail via Google sign-in (official Gmail API). Create an OAuth "Web application" client in
# Google Cloud Console with redirect URI  ${APP_URL}/api/integrations/google/callback
# Not needed if you connect Gmail with an App Password on the Integrations page.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Folder for proposal PDFs and logos (private; never inside public/). Default: ./storage
# STORAGE_DIR="storage"

# Leave unset: after the first owner registers, owners add people from Account & Team.
# ALLOW_REGISTRATION="true"

# Server log detail: debug | info (default) | warn | error. Logs are JSON lines with secrets redacted.
# LOG_LEVEL="info"

# "true" turns off the daily retention clean-up (expired sessions, old jobs, files of deleted records).
# DISABLE_MAINTENANCE="true"
